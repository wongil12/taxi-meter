{
  "expo": {
    "name": "택시 미터",
    "slug": "taxi-meter",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wongil.taximeter",
      "buildNumber": "4",
      "appleTeamId": "Y6963W3U5A",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wongil.taximeter"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "운행 기록을 위해 이동 거리와 시간을 측정합니다. 미터기에서는 거리와 저속 시간으로 요금을 계산합니다."
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.wongil.taximeter.widgets",
          "groupIdentifier": "group.com.wongil.taximeter",
          "widgets": []
        }
      ],
      "./plugins/withTaxiCarPlay"
    ],
    "scheme": "taximeter",
    "icon": "./assets/taxi-icon.png"
  }
}
